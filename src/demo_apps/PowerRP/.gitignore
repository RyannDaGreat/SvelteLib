# Project storage is USER DATA, not source (manifest Round 12: projects are
# folders — doc.json + assets/, the assets/ folder being the asset-library
# source of truth). Keep the folder, ignore its contents.
projects/*
!projects/.gitkeep

# Python backend cruft
server/__pycache__/
.venv/

# Auto-generated self-signed dev certificates (opt-in HTTPS mode)
server/.tls/

# Vite build output (this app builds into web/dist)
web/dist/

# PROBE SCREENSHOTS WRITTEN BESIDE THEIR PROBE. A probe's own output is an
# ARTIFACT, not source: tests/surge_gui_probe.js writes tests/surge_gui_probe.png
# on every run, and it turned up untracked in a working tree three agents were
# committing from — one `git add -A` away from being mistaken for a fixture.
# Fixtures live in tests/fixtures/ (checker.png, latex_equation.png) and are
# tracked; anything a probe writes into tests/ itself is not.
tests/*.png
!tests/fixtures/*.png
